    "bodyHtml": "\n                    <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:16.0pt\"><span style=\"font-family:宋体\">各位党员：</span></span></span></span></p>\n\n<p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:16.0pt\"><span style=\"font-family:宋体\">&nbsp; 奋进新征程、建功新时代。为深入学习贯彻党的二十大精神，做好相关政策解读，聚焦维护核心，积极传播党的新声音、党的新理论，请广大流动党员认真学习《党的二十大报告辅导读本</span></span> <span style=\"font-size:16.0pt\"><span style=\"font-family:宋体\">》和《中共中央日前作出关于认真学习贯彻党的二十大精神的决定》。</span></span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span></p>\n\n<p style=\"text-align:justify\">&nbsp;</p>\n\n<p style=\"text-align:justify\">&nbsp;</p>\n\n<p style=\"text-align:right\"><span style=\"font-size:10.5pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:16.0pt\"><span style=\"font-family:宋体\">流动党员支部</span></span></span></span></p>\n\n<p style=\"text-align:right\"><span style=\"font-size:10.5pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:16.0pt\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2022</span><span style=\"font-size:16.0pt\"><span style=\"font-family:宋体\">年</span></span><span style=\"font-size:16.0pt\">11</span><span style=\"font-size:16.0pt\"><span style=\"font-family:宋体\">月</span></span><span style=\"font-size:16.0pt\">23</span><span style=\"font-size:16.0pt\"><span style=\"font-family:宋体\">日</span></span></span></span></p>\n\n                ",

    "bodyHtml": "\n                        <div class=\"mainlist bor\">\n            <h5>\n                <div class=\"ttt text20\">\n                    通知公告</div>\n            </h5>\n            <div>\n                <div class=\"titles\">\n                    <span id=\"lblTitle\" style=\"display:inline-block;\"><b><font size=\"5\">3月24日上午9点至11点30分咨询电话暂停服务</font></b></span>\n                </div>\n                <div class=\"xian2\">\n                </div>\n                <div class=\"Issues\">\n                    <span id=\"lblIssue\" style=\"display:inline-block;\"><font size=\"3\">发布部门:综合部   发布时间:2017-3-24 9:16:15</font></span>\n                </div>\n               \n                <div id=\"tdNoticesContent\"><p style=\";text-align: left\"><span style=\";font-family: 宋体\">广大毕业生</span><span style=\"font-family:Calibri\">:</span></p><p style=\";text-align: left\"><span style=\"font-family:Calibri\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><span style=\";font-family: 宋体\">因筹备</span><span style=\"font-family:Calibri\">2017</span><span style=\";font-family: 宋体\">年吉林省普通高校专升本教育考试相关工作，</span><span style=\"font-family:Calibri\">3</span><span style=\";font-family: 宋体\">月</span><span style=\"font-family:Calibri\">24</span><span style=\";font-family: 宋体\">日上午</span><span style=\"font-family:Calibri\">9</span><span style=\";font-family: 宋体\">点至</span><span style=\"font-family:Calibri\">11</span><span style=\";font-family: 宋体\">点</span><span style=\"font-family:Calibri\">30</span><span style=\";font-family: 宋体\">分咨询电话暂停服务，特此通知。</span></p><p style=\";text-align: left\"><span style=\"font-family:Calibri\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></p><p style=\";text-align: left\"><span style=\"font-family:Calibri\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&n
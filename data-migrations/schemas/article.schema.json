{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jilinjobs.local/schemas/historical-article.schema.json",
  "title": "Historical Article Migration Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "target", "content", "resources", "sourceFingerprint"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "legacyKey", "typeCode", "detailPath", "url"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "legacyKey": { "type": "string", "minLength": 1 },
        "contentId": { "type": ["string", "null"] },
        "typeCode": { "type": "string", "minLength": 1 },
        "detailPath": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columnAlias", "articleType"],
      "properties": {
        "columnAlias": { "type": "string", "minLength": 1 },
        "articleType": { "enum": ["INTERNAL", "EXTERNAL_LINK"] }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "source", "publishDate", "bodyHtml", "externalUrl"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "type": "string", "maxLength": 200 },
        "publishDate": { "type": ["string", "null"], "format": "date" },
        "bodyHtml": { "type": "string" },
        "externalUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "sourceUrl", "snapshotPath", "sha256"],
        "properties": {
          "role": { "enum": ["BODY_IMAGE", "ATTACHMENT"] },
          "sourceUrl": { "type": "string", "format": "uri" },
          "snapshotPath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "contentType": { "type": ["string", "null"] },
          "sizeBytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sourceFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

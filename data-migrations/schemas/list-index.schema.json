{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jilinjobs.local/schemas/historical-list-index.schema.json",
  "title": "Historical List Migration Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["listCode", "sourceSystem", "items"],
  "properties": {
    "listCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,99}$"
    },
    "sourceSystem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "sourcePage": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["legacyKey", "path", "sourceOrder", "sourceFingerprint"],
        "properties": {
          "legacyKey": { "type": "string", "minLength": 1, "maxLength": 255 },
          "path": { "type": "string", "minLength": 1 },
          "sourceOrder": { "type": "integer", "minimum": 1 },
          "sourceFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}

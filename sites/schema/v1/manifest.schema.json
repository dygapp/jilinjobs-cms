{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jilinjobs.local/site-package/v1/manifest.schema.json",
  "title": "Site Package v1 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageId", "schemaVersion", "version", "structure"],
  "properties": {
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": { "const": "columns" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}

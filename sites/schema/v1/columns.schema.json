{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jilinjobs.local/site-package/v1/columns.schema.json",
  "title": "Site Package v1 Columns",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["alias", "name", "parentAlias", "coverPolicy", "sortOrder", "enabled", "preset"],
    "properties": {
      "alias": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "parentAlias": {
        "type": ["string", "null"],
        "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
      },
      "coverPolicy": {
        "enum": ["NONE", "OPTIONAL", "REQUIRED"]
      },
      "sortOrder": {
        "type": "integer"
      },
      "enabled": {
        "type": "boolean"
      },
      "preset": {
        "const": true
      }
    }
  }
}

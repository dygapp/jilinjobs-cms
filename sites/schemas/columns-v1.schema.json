{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jilinjobs.local/site-package/columns-v1.schema.json",
  "title": "Site Package Columns v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["columns"],
  "properties": {
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "name"],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "parentAlias": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
          },
          "coverPolicy": {
            "enum": ["NONE", "OPTIONAL", "REQUIRED"]
          },
          "sortOrder": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
